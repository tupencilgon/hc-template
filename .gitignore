# ---------------------------------------------------------
# Unity generated folders
# ---------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Recordings can get excessive in size
[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------
.vs/
.vscode/
.gradle/
.idea/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------
# OS generated
# ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Thumbs.db.meta

# ---------------------------------------------------------
# Unity3D generated build files
# ---------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
*.ipa
*.xcarchive

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------
# Secrets — KHÔNG commit key/ID thật
# ---------------------------------------------------------
google-services.json
GoogleService-Info.plist
*.keystore
*.jks
keystore.properties
Assets/_Project/Resources/AdConfig.local.asset

# ---------------------------------------------------------
# SDK bên thứ 3 — KHÔNG commit
# Firebase chứa file 107MB, vượt giới hạn 100MB/file của GitHub.
# Import lại bằng .unitypackage theo đúng version ghi trong README.
# ---------------------------------------------------------
/[Aa]ssets/Firebase/
/[Aa]ssets/Firebase.meta
/[Aa]ssets/GameAnalytics/
/[Aa]ssets/GameAnalytics.meta
/[Aa]ssets/ExternalDependencyManager/
/[Aa]ssets/ExternalDependencyManager.meta
/[Aa]ssets/Editor Default Resources/
/[Aa]ssets/Editor Default Resources.meta
/[Aa]ssets/Plugins/Android/
/[Aa]ssets/Plugins/Android.meta
/[Aa]ssets/Plugins/iOS/
/[Aa]ssets/Plugins/iOS.meta
/[Aa]ssets/Plugins/tvOS/
/[Aa]ssets/Plugins/tvOS.meta
/[Aa]ssets/Plugins/x86_64/
/[Aa]ssets/Plugins/x86_64.meta

# Key GameAnalytics nằm trong file này — không đẩy lên repo công khai
/[Aa]ssets/Resources/GameAnalytics/
/[Aa]ssets/Resources/GameAnalytics.meta

# Meta của file/thư mục đã bị chặn ở trên — giữ lại chỉ tạo meta mồ côi
/[Aa]ssets/google-services.json.meta
/[Aa]ssets/Resources.meta
/[Aa]ssets/StreamingAssets/
/[Aa]ssets/StreamingAssets.meta
